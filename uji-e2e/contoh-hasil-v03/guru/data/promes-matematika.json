  "tp": {
    "TP1": {
      "tujuan": "Membaca, menulis, membandingkan, dan mengurutkan bilangan cacah sampai 10.000 berdasarkan nilai tempat",
      "materi": "Bilangan cacah sampai 10.000",
      "semester": 1,
      "jp": 15
    },
    "TP2": {
      "tujuan": "Menentukan hasil penjumlahan dan pengurangan bilangan cacah sampai 1.000 serta menyelesaikan masalahnya",
      "materi": "Penjumlahan dan pengurangan sampai 1.000",
      "semester": 1,
      "jp": 15
    },
    "TP3": {
      "tujuan": "Menentukan hasil perkalian dan pembagian bilangan cacah sampai 100 serta menyelesaikan masalahnya",
      "materi": "Perkalian dan pembagian sampai 100",
      "semester": 1,
      "jp": 20
    },
    "TP4": {
      "tujuan": "Menentukan kelipatan dan faktor suatu bilangan serta menyelesaikan masalah yang berkaitan",
      "materi": "Kelipatan dan faktor",
      "semester": 1,
      "jp": 10
    },
    "TP5": {
      "tujuan": "Mengembangkan pola gambar dan pola bilangan serta menemukan nilai yang tidak diketahui dalam kalimat matematika penjumlahan dan pengurangan sampai 100",
      "materi": "Pola dan kalimat matematika",
      "semester": 1,
      "jp": 15
    },
    "TP6": {
      "tujuan": "Menyajikan dan menginterpretasi data dalam tabel, piktogram, dan diagram batang skala satu satuan",
      "materi": "Penyajian dan interpretasi data",
      "semester": 1,
      "jp": 10
    },
    "TP7": {
      "tujuan": "Membandingkan dan mengurutkan pecahan, menentukan pecahan senilai, serta menghubungkan pecahan dengan desimal dan persen",
      "materi": "Pecahan, desimal, dan persen",
      "semester": 2,
      "jp": 20
    },
    "TP8": {
      "tujuan": "Menyelesaikan masalah yang berkaitan dengan uang",
      "materi": "Nilai uang dan masalah keuangan",
      "semester": 2,
      "jp": 15
    },
    "TP9": {
      "tujuan": "Mengukur panjang dan berat dengan satuan baku serta menentukan hubungan antarsatuan baku panjang dan berat",
      "materi": "Panjang dan berat baku",
      "semester": 2,
      "jp": 20
    },
    "TP10": {
      "tujuan": "Mengukur dan mengestimasi luas dan volume menggunakan satuan tidak baku dan satuan baku berupa bilangan cacah",
      "materi": "Luas dan volume",
      "semester": 2,
      "jp": 15
    },
    "TP11": {
      "tujuan": "Mendeskripsikan ciri bangun datar serta menyusun dan mengurai bangun datar dengan lebih dari satu cara",
      "materi": "Bangun datar",
      "semester": 2,
      "jp": 15
    }
  },
